package view

import (
	"fmt"
	"math/rand"

	"github.com/google/uuid"

	"ohmysmal/server"
	"ohmysmal/consts"
)

templ SnippetPage(
	s server.MaybeSnippet,
	user server.MaybeUser,
	source string,
	comments []server.Comment,
	reports []server.Report,
) {
	if !s.Ok {
		@page() {
			@pageHead("snippet")
			@pageBody() {
				<div class="container">
					<h1>Failed to load snippet :(</h1>
					<a href="/">go home</a>
				</div>
			}
		}
	} else {
		@snippetFoundPage(s.Snippet, user, source, comments, reports)
	}
}

templ snippetFoundPage(
	s server.Snippet,
	user server.MaybeUser,
	source string,
	comments []server.Comment,
	reports []server.Report,
) {
	{{
		userCanReport := user.Ok && user.User.CanReportSnippet(s.AuthorId)
		userCanDelete := user.Ok && user.User.CanDeleteSnippet(s.AuthorId)
	}}

	@page() {
		@pageHead(fmt.Sprintf("%s by @%s", s.Title, s.AuthorNickname)) {
			<link rel="stylesheet" href="/static/lib/codemirror/codemirror.css" />
			<script src="/static/lib/codemirror/codemirror.js"></script>
			<script src="/static/lib/codemirror/addon-trailingspace.js"></script>
		}
		@pageBody() {
			<div class="container snippet-page-container" id="container">
				@header(user)

				<!-- UXN display -->
				<div class="snippet-display-wrapper">
					<div class="snippet-display">
						<canvas id="display" class="uxn-canvas"></canvas>
					</div>
				</div>

				<div class="muted text-small flex gap-2">
					<span id="display-zoom-button" class="link-ish" title="Zoom">x1</span>
					<a href={ fmt.Sprintf("/editor?snippet=%s", s.Id) }>open in editor</a>

					if userCanReport {
						@snippetReportButton(s)
					}
					if userCanDelete {
						@snippetDeleteButton(s.Id)
					}
				</div>

				if userCanReport {
					@snippetReportForm(s.Id)
				}
				if user.Ok && user.User.Role == server.ROLE_ADMIN && len(reports) > 0 {
					@snippetReports(s.Id, reports)
				}

				<hr />

				<!-- Snippet info -->
				<div class="flex-column width-fill">
					<div class="width-fill flex justify-between gap-2">
						<h2>{s.Title}</h2>
						@TimeAgo(s.Date, "muted text-nowrap")
					</div>
					<span>{"@"}{s.AuthorNickname}</span>
				</div>

				<textarea style="display: none;" id="snippet_source">{source}</textarea>
				<div id="editor-wrapper" style="width: 100%;">/**/</div>

				<hr />

				<div class="snippet-grid">
					@SnippetComments(s.Id, user, comments)
					@SnippetFlowers(s.Id, s.Flowers, s.AuthUserFlowered, user.Ok)
				</div>

				@footer()
			</div>

			@uxnScripts()

			<script src="/static/js/snippet_page.js" type="module"></script>
		}
	}
}

templ SnippetFlowers(id uuid.UUID, count uint, active bool, authed bool) {
	<div
		id="snippet-flowers-wrapper"
		class="snippet-flowers flex-column items-start gap-2"
	>
		if count == 1 {
			<span class="text-small muted">1 person gave a flower</span>
		} else {
			<span class="text-small muted">{count} people gave a flower</span>
		}

		<div
			if !authed {
				class="flower-pot"
				title="Log in to give a flower"
				onclick="openAuthForms()"
			} else if active {
				class="flower-pot active"
				title="Take the flower back"
			} else {
				class="flower-pot"
				title="Give a flower"
			}
			if authed {
				hx-post={ fmt.Sprintf("/api/flower/%s", id) }
				hx-target="#snippet-flowers-wrapper"
				hx-swap="outerHTML"
			}
		>
			<div class="tip muted">
				if !authed {
					<i class="tip-text">~ log in to give a flower ~</i>
				} else if active {
					<i class="tip-text">You gave a flower!</i>
					<i class="tip-loading">Taking the flower back...</i>
				} else {
					<i class="tip-text">Give a flower</i>
					<i class="tip-loading">The flower is flying away...</i>
				}
			</div>
		</div>

		<div class="flex-column">
			// TODO: add and remove flowers on the client, it is not good to
			// render all flowers on the server everytime the number of flowers changes.
			<div class="flowers-pile">
				if count == 0 {
					<i>The pile is empty...</i>
				}

				for i := range count {
					{{ n := rand.Int() % 6 - 3 }}
					{{ style := fmt.Sprintf("animation-delay: %dms; translate: %dpx %dpx;", 100 * i, n, n) }}
					@iconWithStyle("flower", style)
				}
			</div>
		</div>
	</div>
}

templ SnippetComments(
	snippetId uuid.UUID,
	user server.MaybeUser,
	comments []server.Comment,
) {
	<div id="snippet-comments" class="snippet-comments">
		if len(comments) == 1 {
			<span class="text-small muted">1 comment</span>
		} else {
			<span class="text-small muted">{len(comments)} comments</span>
		}

		if user.Ok {
			<form
				class="comment-form"
				hx-post={ fmt.Sprintf("/api/comment/%s", snippetId) }
				hx-target="#snippet-comments"
				hx-swap="outerHTML"
				hx-on::after-request="if(event.detail.successful) this.reset()"
			>
				@FunkyTextarea("text", "Carefully write down your thoughts here...", consts.MAX_COMMENT_TEXT_LEN)
			</form>
		} else {
			<i class="muted">~ log in to leave a comment ~</i>
		}

		<div class="comments-list">
			for _, c := range comments {
				@Comment(user, c)
			}
		</div>
	</div>
}

templ Comment(user server.MaybeUser, c server.Comment) {
	<div class="comment">
		@icon("comment")
		<div class="comment-content">
			<div class="row muted gap-1 width-fill">
				{"@"}{c.AuthorNickname}
				<span>·</span>
				@TimeAgo(c.Date, "")

				if user.Ok && user.User.CanDeleteComment(c.AuthorId) {
					<span>·</span>
					@commentDeleteButton(c.Id)
				}
			</div>
			<p>{c.Text}</p>
		</div>
	</div>
}

templ snippetReports(snippetId uuid.UUID, reports []server.Report) {
	<div class="details-wrapper">
		<details>
			<summary>Reports ({ len(reports) })</summary>

			<div class="details-content">
				<span
					class="link-ish text-red"
					hx-confirm="Are you sure you want to delete all reports from this snippet?"
					hx-delete={ fmt.Sprintf("/api/reports/%s", snippetId) }
					hx-on::after-request="if (event.detail.successful) location.reload()"
				>delete all</span>

				<table border="0" cellspacing="0" cellpadding="0">
					@snippetReportsList(reports)
				</table>
			</div>
		</details>
	</div>
}

templ snippetReportsList(reports []server.Report) {
	<tr>
		<th>Violation</th>
		<th>Reporter</th>
		<th>Date</th>
	</tr>

	for _, r := range reports {
		<tr>
			<td>{server.ViolationStr(r.Violation)}</td>
			<td>{"@"}{r.AuthorNickname}</td>
			<td>@TimeAgo(r.Date, "")</td>
		</tr>
	}
}

templ violationRadio(value, title, description string) {
	<label class="radio-label">
		<input type="radio" name="violation" value={value} required />
		<div class="col gap-1">
			<b>{title}</b>
			<p>{description}</p>
		</div>
	</label>
}

templ snippetReportForm(snippetId uuid.UUID) {
	<form
		id="snippet-report"
		class="report-form hidden"
		hx-post={ fmt.Sprintf("/api/report/%s", snippetId) }
		hx-confirm="Are you sure you want to report this snippet?"
		hx-on::after-request="if (event.detail.successful) location.reload()"
	>
		<div class="report-form-content">
			<div class="radio-group">
				@violationRadio("spam", "Spam", "The exact same snippet was posted more than once.")
				@violationRadio("politics", "Politics", "Any polical statement is present in the snippet.")
				@violationRadio("shocking", "Shocking content", "This snippet makes me uncomfortable.")
				@violationRadio("hatred", "Hatred", "Hate to a person or a group of people.")
				@violationRadio("porn", "Porn", "Pornographic or NSFW (not safe for work) content.")
			</div>

			<button type="submit" class="button" style="margin-top: 1rem;">submit</button>
		</div>
	</form>
}

templ commentDeleteButton(id uint) {
	<span
		class="link-ish text-red"
		title="Delete this comment"
		hx-confirm="Are you sure you want to delete this comment?"
		hx-delete={ fmt.Sprintf("/api/comment/%d", id) }
		hx-target="#snippet-comments"
		hx-swap="outerHTML"
	>
		@icon("trash")
	</span>
}

templ snippetDeleteButton(id uuid.UUID) {
	<span
		class="link-ish text-red"
		title="Delete this snippet"
		hx-confirm="Are you sure you want to delete this snippet?"
		hx-delete={ fmt.Sprintf("/api/snippet?id=%s", id) }
	>
		@icon("trash")
	</span>
}

templ snippetReportButton(s server.Snippet) {
	if s.AuthUserRepoted {
		<span
			class="link-ish"
			title="Take the report back from this snippet"
			hx-delete={ fmt.Sprintf("/api/report/%s", s.Id) }
			hx-swap="none"
			hx-on::after-request="if (event.detail.successful) location.reload()"
		>
			take my report back
		</span>
	} else {
		<span
			class="link-ish text-red"
			title="Report this snippet"
			onclick="toggleElement('snippet-report')"
		>
			report
		</span>
	}
}
